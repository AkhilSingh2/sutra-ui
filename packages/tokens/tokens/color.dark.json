{
  "color": {
    "bg": {
      "$type": "color",
      "canvas": { "$value": "{color.ink.950}" },
      "surface": { "$value": "{color.ink.800}" },
      "subtle": { "$value": "#26222e" },
      "sunken": { "$value": "#0b090e" },
      "inverse": { "$value": "{color.ivory.100}" },
      "primary": { "$value": "{color.ivory.100}" },
      "primary-hover": { "$value": "{color.ivory.50}" },
      "primary-subtle": { "$value": "#142824" },
      "accent": { "$value": "{color.oxblood.500}" },
      "accent-hover": { "$value": "#a24a42" },
      "accent-subtle": { "$value": "#2a1818" },
      "danger": { "$value": "{color.oxblood.500}" },
      "danger-hover": { "$value": "#a24a42" },
      "danger-subtle": { "$value": "#2a1616" },
      "success": { "$value": "#2f6a56" },
      "success-subtle": { "$value": "#12241c" },
      "warning-subtle": { "$value": "#2a2416" },
      "info-subtle": { "$value": "{color.indigo.900}" }
    },
    "fg": {
      "$type": "color",
      "default": { "$value": "{color.ivory.100}" },
      "muted": { "$value": "{color.ivory.400}" },
      "on-primary": { "$value": "{color.ink.950}" },
      "on-accent": { "$value": "{color.ivory.100}" },
      "on-danger": { "$value": "{color.ivory.100}" },
      "on-success": { "$value": "{color.ivory.100}" },
      "on-inverse": { "$value": "{color.ink.950}" },
      "link": { "$value": "{color.emerald.300}" },
      "primary": { "$value": "{color.emerald.300}" },
      "accent": { "$value": "{color.oxblood.300}" },
      "danger": { "$value": "{color.oxblood.300}" },
      "success": { "$value": "#b7d4c4" },
      "warning": { "$value": "{color.gold.300}" },
      "info": { "$value": "{color.indigo.300}" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{color.gold.500}" },
      "strong": { "$value": "{color.gold.300}" },
      "primary": { "$value": "{color.emerald.300}" }
    },
    "focus": { "$type": "color", "ring": { "$value": "{color.gold.300}" } },
    "thread": {
      "$type": "color",
      "start": { "$value": "{color.gold.300}" },
      "end": { "$value": "{color.emerald.300}" }
    }
  },
  "gradient": {
    "rule": {
      "$type": "other",
      "$value": "linear-gradient(90deg, transparent, #c4b49a 18%, #c4b49a 82%, transparent)"
    },
    "veil": {
      "$type": "other",
      "$value": "radial-gradient(640px 300px at 100% 0%, rgba(196, 180, 154, 0.12), transparent 60%)"
    }
  },
  "pattern": {
    "kalamkari": {
      "$type": "other",
      "$value": "repeating-linear-gradient(90deg, transparent 0 23px, rgba(196, 180, 154, 0.28) 23px 24px), repeating-linear-gradient(0deg, transparent 0 23px, rgba(196, 180, 154, 0.28) 23px 24px)"
    },
    "blockprint": {
      "$type": "other",
      "$value": "repeating-linear-gradient(135deg, transparent 0 15px, rgba(228, 178, 170, 0.2) 15px 16px)"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(0, 0, 0, 0.35)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "rgba(0, 0, 0, 0.28)", "offsetX": "0px", "offsetY": "10px", "blur": "24px", "spread": "0px" }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(0, 0, 0, 0.3)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "rgba(0, 0, 0, 0.4)", "offsetX": "0px", "offsetY": "18px", "blur": "40px", "spread": "0px" }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        { "color": "rgba(0, 0, 0, 0.35)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" },
        { "color": "rgba(0, 0, 0, 0.5)", "offsetX": "0px", "offsetY": "32px", "blur": "64px", "spread": "0px" }
      ]
    }
  }
}
