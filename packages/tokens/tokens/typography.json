{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$description": "Body text uses Inter. Devanagari falls through to Noto Sans Devanagari, then Nirmala UI and Mangal. All webfonts are SIL Open Font License.",
        "$value": ["Inter", "Noto Sans Devanagari", "Nirmala UI", "Mangal", "sans-serif"]
      },
      "display": {
        "$type": "fontFamily",
        "$description": "Fraunces for editorial display. Devanagari falls through to Noto Sans Devanagari. Both are SIL Open Font License.",
        "$value": ["Fraunces", "Noto Sans Devanagari", "Iowan Old Style", "Palatino", "serif"]
      },
      "mono": {
        "$type": "fontFamily",
        "$description": "IBM Plex Mono for figures and code, with Noto Sans Mono as the OFL fallback.",
        "$value": ["IBM Plex Mono", "Noto Sans Mono", "ui-monospace", "monospace"]
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.375rem" },
      "2xl": { "$value": "1.75rem" },
      "3xl": { "$value": "2.25rem" },
      "4xl": { "$value": "3.25rem" },
      "display": { "$value": "4.5rem" }
    },
    "line": {
      "$type": "dimension",
      "xs": { "$value": "1.125rem" },
      "sm": { "$value": "1.375rem" },
      "md": { "$value": "1.55rem" },
      "lg": { "$value": "1.7rem" },
      "xl": { "$value": "1.8rem" },
      "2xl": { "$value": "2.15rem" },
      "3xl": { "$value": "2.7rem" },
      "4xl": { "$value": "3.6rem" },
      "display": { "$value": "4.9rem" }
    }
  }
}
