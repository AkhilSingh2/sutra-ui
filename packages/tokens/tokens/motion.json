{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "160ms" },
      "normal": { "$value": "280ms" },
      "slow": { "$value": "460ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.34, 1.4, 0.64, 1] },
      "emphasis": { "$value": [0.22, 1.7, 0.36, 1] }
    }
  }
}
